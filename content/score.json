	"about": "Every piece of music in the game. view/audio/score.gd says what each field means; the soundtrack editor (node tools/data-browser/server.mjs) edits this file and bakes audio/music from it.",
	"places": {
		"HOME": {"about": "The workshop: warm, unhurried, a guitar by the fire. No fight is ever had here, so it is written in three layers only.", "tracks": ["home_bench", "home_lamplight"]},
		"QUARRY": {"about": "The Quarry: timber, lamp oil and dust. Earthy and folk-like, mostly dorian.", "tracks": ["quarry_lantern", "quarry_timber", "quarry_galleries"]},
		"SEEPS": {"about": "The Seeps: water in every crack. Slow, wet, echoing; bells that drip.", "tracks": ["seeps_lanterns", "seeps_sluice", "seeps_sump"]},
		"GLASS_VEINS": {"about": "The Glass Veins: crystal. Bright, ringing, lydian, arpeggios like light through a prism.", "tracks": ["glass_prism", "glass_kaleidoscope", "glass_black"]},
		"WARRENS": {"about": "The Warrens: fungus and roots. Woody, organic, a little sick.", "tracks": ["warrens_rootwork", "warrens_spores", "warrens_heartrot"]},
		"FURNACE": {"about": "The Furnace: lava and slag. Heavy, hammered, harmonic minor, anvils on the backbeat.", "tracks": ["furnace_anvil", "furnace_slagfall", "furnace_kiln"]},
		"GEODE": {"about": "The Geode: crystal and gold. Wonder, a little grandeur; choirs and bells.", "tracks": ["geode_amethyst", "geode_gilded", "geode_crown"]},
		"RIFT": {"about": "The Rift: below everything. Slow, unmoored, detuned; the ground has stopped making sense.", "tracks": ["rift_void", "rift_remembered", "rift_unmaking"]}
	},
